<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The game's Info.plist on iPhone and iPad. CMake fills the MACOSX_BUNDLE names in from the target's properties
     (ios/ios.cmake). CMake substitutes inside comments too, so no comment here may write a dollar sign and a brace.
     apps/game/ios/verify_game_app.sh checks the built bundle against what this file says. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <!-- The build number. TestFlight refuses a build whose number is not higher than every earlier one for the same
         version, so the release workflow gives the number of its run (HEART_BOOM_MATHS_IOS_BUILD_NUMBER). -->
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <!-- The icon: the AppIcon set of ios/Assets.xcassets, a placeholder that a designer replaces
         (tools/assets/make_placeholder_icon.py). -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <!-- The game uses no encryption of its own and makes no network request of its own, and what the system gives it is
         exempt: without this key TestFlight asks about encryption for every build. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Game Center is the only service the game needs from the device, and it is optional in the game (a Settings switch,
         off by default). -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>gamekit</string>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>

    <!-- No usage text for any permission: the game asks for none (no camera, microphone, location, photos, contacts,
         tracking or notifications). Add the text with the first permission it asks for; verify_game_app.sh refuses the keys
         it lists until then. -->

    <!-- A launch screen in the property list: without one iOS runs the program in a legacy 320 x 480 window and scales it
         up. The colour is in Assets.xcassets (LaunchBackground). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!-- A phone is held upright (docs/game-architecture.md). A tablet turns any way, and takes the whole screen with no
         split view or slide over, which is what TestFlight asks of an iPad application that is not available in every
         orientation. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- A game draws the whole screen: no status bar. The setting of the property list rules, not the view controller's
         (Qt's own view controller is the one on screen). -->
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
</dict>
</plist>
