{
  "version": 8,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, Debug, Tracy on",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ICL_ENABLE_TRACY": "ON", "VCPKG_MANIFEST_FEATURES": "profiling" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux, Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux, AddressSanitizer and UBSan, -O1",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "ICL_SANITIZERS": "address,undefined" }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux, ThreadSanitizer, -O1",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "ICL_SANITIZERS": "thread" }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux, coverage",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ICL_ENABLE_COVERAGE": "ON" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "VCPKG_TARGET_TRIPLET": "arm64-osx" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows, MSVC, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "CMAKE_POLICY_DEFAULT_CMP0141": "NEW"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows, MSVC, AddressSanitizer, /O1",
      "inherits": "windows-msvc-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "ICL_SANITIZERS": "address" }
    },
    {
      "name": "ios-release",
      "displayName": "iOS (device, Release, unsigned)",
      "description": "An iPhone or iPad (arm64), built by Xcode on a Mac. Unsigned: it needs no Apple account (a signed build is the release workflow's). vcpkg's toolchain is the toolchain file, as everywhere (VCPKG_ROOT is a vcpkg checkout at the baseline of vcpkg.json; CI's setup-vcpkg action sets it). No tests and no command-line program are built: nothing runs on a device here.",
      "inherits": "base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_XCODE_GENERATE_SCHEME": "ON",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": "",
        "HEART_BOOM_MATHS_BUILD_TESTS": "OFF",
        "HEART_BOOM_MATHS_BUILD_GAME": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-game-release",
      "displayName": "iOS game (device, Release, unsigned, Qt static)",
      "description": "The whole game on an iPhone or iPad (arm64), built by Xcode on a Mac against Qt's static iOS kit. Unsigned unless given the signing variables (the release workflow passes HEART_BOOM_MATHS_IOS_SIGNING_TEAM, _PROFILE, _BUILD_NUMBER and _GAME_CENTER on the command line, docs/ios.md): it needs no Apple account. Needs HEART_BOOM_MATHS_QT_IOS_ROOT (the ios kit of the pinned Qt version) and ICL_QT_ROOT (the macOS desktop kit of the same version, which Qt uses as its host tools). No tests are built: vcpkg is not used and nothing runs on a device here. apps/ios, the one-screen stub, is not built.",
      "inherits": "base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "toolchainFile": "$env{HEART_BOOM_MATHS_QT_IOS_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "QT_HOST_PATH": "$env{ICL_QT_ROOT}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_XCODE_GENERATE_SCHEME": "ON",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": "",
        "HEART_BOOM_MATHS_BUILD_TESTS": "OFF",
        "HEART_BOOM_MATHS_BUILD_GAME": "ON",
        "HEART_BOOM_MATHS_BUILD_IOS_APP": "OFF",
        "HEART_BOOM_MATHS_USE_QT_MULTIMEDIA": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-core",
      "displayName": "WebAssembly, the rules and the text harness, to run under Node",
      "description": "libs/core and the text harness built with Emscripten alone (no Qt, no vcpkg), so the golden replays can be checked under Node: `node build/wasm-core/libs/core/heart_boom_maths_harness.js --check libs/core/tests/data/replays`. Needs EMSDK (an activated emsdk).",
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "$env{EMSDK}", "rhs": "" },
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HEART_BOOM_MATHS_BUILD_TESTS": "OFF",
        "HEART_BOOM_MATHS_BUILD_GAME": "OFF",
        "HEART_BOOM_MATHS_BUILD_HARNESS": "ON",
        "HEART_BOOM_MATHS_BUILD_IOS_APP": "OFF"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly, Release, single-threaded",
      "description": "The game in a browser, built with Qt's single-threaded WebAssembly kit. Needs EMSDK (an activated emsdk of the Emscripten release the kit was built with: 5.0.5 for Qt 6.12.0, which the kit insists on), HEART_BOOM_MATHS_QT_WASM_ROOT (the wasm_singlethread kit) and ICL_QT_ROOT (the desktop kit of the same Qt version, which Qt uses as its host tools). The finished site is build/wasm-release/site. No tests are built: vcpkg is not used and a browser cannot run them.",
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "$env{EMSDK}", "rhs": "" },
      "toolchainFile": "$env{HEART_BOOM_MATHS_QT_WASM_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "QT_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "QT_HOST_PATH": "$env{ICL_QT_ROOT}",
        "CMAKE_BUILD_TYPE": "Release",
        "HEART_BOOM_MATHS_BUILD_TESTS": "OFF",
        "HEART_BOOM_MATHS_BUILD_GAME": "ON",
        "HEART_BOOM_MATHS_BUILD_IOS_APP": "OFF"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "description": "An Android phone or tablet, built from any host with Qt's Android kit (HEART_BOOM_MATHS_QT_ANDROID_ROOT, for example Qt/6.12.0/android_arm64_v8a: the kit names the architecture), a desktop kit of the same Qt version for the host tools and androiddeployqt (ICL_QT_ROOT), the Android SDK (ANDROID_SDK_ROOT), the NDK that kit was built with (ANDROID_NDK_ROOT) and a JDK 17 or later. `cmake --build --preset <name>` makes the packages. No tests are built: vcpkg is not used and nothing runs on a device here. The C++ module dependency scan is off: nothing here uses modules.",
      "condition": { "type": "notEquals", "lhs": "$env{HEART_BOOM_MATHS_QT_ANDROID_ROOT}", "rhs": "" },
      "toolchainFile": "$env{HEART_BOOM_MATHS_QT_ANDROID_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "QT_HOST_PATH": "$env{ICL_QT_ROOT}",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "HEART_BOOM_MATHS_BUILD_TESTS": "OFF",
        "HEART_BOOM_MATHS_BUILD_GAME": "ON",
        "HEART_BOOM_MATHS_BUILD_IOS_APP": "OFF"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android (arm64-v8a, Release, unsigned)",
      "description": "What a release is made from: an unsigned APK and AAB. A package signed with the upload key needs QT_ANDROID_SIGN_AAB (or QT_ANDROID_SIGN_APK) and the QT_ANDROID_KEYSTORE_* environment variables, which only the tag build has (docs/releasing.md).",
      "inherits": "android-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android (arm64-v8a, Debug, debug-signed)",
      "description": "A debuggable APK signed with Android's own debug key, which installs on any device that allows apps from outside the store.",
      "inherits": "android-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "QT_ANDROID_DEPLOYMENT_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "configuration": "Release" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "ios-release", "configurePreset": "ios-release", "configuration": "Release" },
    { "name": "ios-game-release", "configurePreset": "ios-game-release", "configuration": "Release" },
    { "name": "wasm-core", "configurePreset": "wasm-core" },
    { "name": "wasm-release", "configurePreset": "wasm-release" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release", "targets": ["apk", "aab"] },
    { "name": "android-arm64-debug", "configurePreset": "android-arm64-debug", "targets": ["apk"] }
  ],
  "testPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "linux-tsan", "configurePreset": "linux-tsan", "output": { "outputOnFailure": true } },
    { "name": "linux-coverage", "configurePreset": "linux-coverage", "output": { "outputOnFailure": true } }
  ]
}
